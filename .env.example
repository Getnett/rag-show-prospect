# Copy to .env and fill in. Never commit .env.
# Week 0 spikes only. Platform variables are added in build week 1.

# Free tiers: development with synthetic or your own data only (they may train on inputs)
GEMINI_API_KEY=
GROQ_API_KEY=

# Paid, non-training: real chats and final evals. Set a hard usage limit in the OpenAI dashboard.
OPENAI_API_KEY=

# Observability (week 1)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
